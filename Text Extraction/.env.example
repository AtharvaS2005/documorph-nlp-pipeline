# You can store real values in .env.environment, .env.extraction, or .env in this folder.
# The OCR script loads .env.environment, then .env.extraction, then .env, then .env.example.

# Free local DeepSeek-OCR mode (default backend)
DEEPSEEK_TABLE_BACKEND=local
DEEPSEEK_TABLE_MODEL=deepseek-ai/DeepSeek-OCR
DEEPSEEK_LOCAL_BASE_SIZE=1024
DEEPSEEK_LOCAL_IMAGE_SIZE=640

# Optional API mode (only used when DEEPSEEK_TABLE_BACKEND=api)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
